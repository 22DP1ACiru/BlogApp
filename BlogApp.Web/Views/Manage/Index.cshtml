@model BlogApp.Web.Models.ProfileViewModel
@{
    ViewData["Title"] = "User Profile";
    var defaultProfilePic = "/images/default-profile.png";
    var profilePicUrl = Model.ProfilePictureUrl ?? defaultProfilePic;
    bool hasCustomPicture = !string.IsNullOrEmpty(Model.ProfilePictureUrl);
}

<h1><i class="bi bi-person-badge me-2"></i>@ViewData["Title"]</h1>
<hr />

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <strong>Please correct the following errors:</strong>
        <div asp-validation-summary="All" class="mb-0"></div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (ViewBag.StatusMessage != null)
{
    <div class="alert alert-@(!string.IsNullOrEmpty(ViewBag.StatusMessage) && (ViewBag.StatusMessage.Contains("Error") || ViewBag.StatusMessage.Contains("failed")) ? "danger" : "success") alert-dismissible fade show" role="alert">
        @ViewBag.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}


<div class="row">
    <div class="col-md-4 text-center mb-3 mb-md-0">
        <img id="profilePicturePreview" src="@profilePicUrl" alt="Profile Picture" class="rounded-circle mb-3 shadow" style="width: 200px; height: 200px; object-fit: cover; border: 3px solid #eee;" />
        @if (hasCustomPicture)
        {
            <form method="post" asp-action="RemoveProfilePicture" onsubmit="return confirm('Are you sure you want to remove your profile picture?');">
                 @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash2 me-1"></i>Remove Current Picture</button>
            </form>
        }
    </div>
    <div class="col-md-8">
        <form method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>

            <fieldset disabled class="mb-3">
                <legend class="fs-5">Account Details</legend>
                <div class="form-floating mb-3">
                    <input asp-for="Username" class="form-control" />
                    <label asp-for="Username"></label>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Email" class="form-control" />
                    <label asp-for="Email"></label>
                </div>
            </fieldset>
            
            <div class="mb-3">
                <label asp-for="ProfilePicture" class="form-label fw-bold">Change Profile Picture</label>
                <input asp-for="ProfilePicture" type="file" class="form-control" id="profilePictureInput" accept="image/png, image/jpeg, image/gif" />
                <span asp-validation-for="ProfilePicture" class="text-danger"></span>
                <div class="form-text">Upload a new picture to change it. Max size: 1MB. (JPG, PNG, GIF)</div>
            </div>

            <div class="mt-3 d-flex justify-content-between">
                <button id="saveProfileButton" type="submit" class="btn btn-primary" disabled><i class="bi bi-save me-1"></i>Save Profile Changes</button>
                <a asp-action="ChangePassword" class="btn btn-outline-secondary"><i class="bi bi-key me-1"></i>Change Password</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const fileInput = document.getElementById('profilePictureInput');
            const saveButton = document.getElementById('saveProfileButton');
            const profilePicturePreview = document.getElementById('profilePicturePreview');
            const defaultPic = '@defaultProfilePic';

            if (fileInput && saveButton && profilePicturePreview) {
                fileInput.addEventListener('change', function () {
                    saveButton.disabled = !(fileInput.files && fileInput.files.length > 0);
                    if (fileInput.files && fileInput.files[0]) {
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            profilePicturePreview.src = e.target.result;
                        }
                        reader.readAsDataURL(fileInput.files[0]);
                    } else {
                        // If no file selected or selection cleared, revert to original or default
                        // This part might be tricky if the original URL is not easily accessible client-side after new selection
                        // For simplicity, let's just manage button state here. Preview will update if form fails and reloads.
                    }
                });
            }
        });
    </script>
}