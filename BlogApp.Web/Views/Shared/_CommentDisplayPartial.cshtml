@model BlogApp.Web.Models.CommentViewModel
@using System.Security.Claims
@using BlogApp.Core.Constants

@{
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isCommentAuthor = (currentUserId == Model.AuthorId);
    var articleIdForView = ViewData["ArticleId"];
    var defaultProfilePic = "/images/default-profile.png";
    var authorProfilePic = string.IsNullOrEmpty(Model.AuthorProfilePictureUrl) ? defaultProfilePic : Model.AuthorProfilePictureUrl;
}

<div class="d-flex mb-3 comment-container @(Model.IsBlocked ? "blocked-comment" : "")" id="comment-@Model.Id">
    <div class="flex-shrink-0 me-3">
        <img src="@authorProfilePic" alt="@Model.AuthorUsername" class="rounded-circle comment-author-img">
    </div>
    <div class="flex-grow-1">
        <div class="comment-display-content">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <h6 class="mt-0 mb-0 fw-bold">@Model.AuthorUsername</h6>
                    <small class="text-muted">
                        @Model.CreatedDate.ToString("MMM dd, yyyy 'at' h:mm tt")
                        @if (Model.LastUpdatedDate.HasValue)
                        {
                            <span class="fst-italic"> (edited @Model.LastUpdatedDate.Value.ToString("MMM dd, h:mm tt"))</span>
                        }
                    </small>
                </div>
                <div class="comment-actions-display ms-2">
                    @if (Model.CanEdit)
                    {
                        <button type="button" class="btn btn-sm btn-outline-secondary me-1 edit-comment-button" data-comment-id="@Model.Id" title="Edit Comment"><i class="bi bi-pencil"></i></button>
                    }
                    @if (Model.CanDelete)
                    {
                        <form asp-controller="Comments" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this comment?');">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="commentId" value="@Model.Id" />
                            <input type="hidden" name="articleId" value="@articleIdForView" />
                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete Comment"><i class="bi bi-trash"></i></button>
                        </form>
                    }
                     @if (User.Identity != null && User.Identity.IsAuthenticated && !isCommentAuthor && !Model.IsBlocked)
                    {
                        <button type="button" class="btn btn-sm btn-outline-warning ms-1 report-comment-button"
                                data-bs-toggle="modal" data-bs-target="#reportCommentModal"
                                data-comment-id="@Model.Id"
                                data-article-id="@articleIdForView"
                                title="Report this comment">
                            <i class="bi bi-exclamation-triangle"></i>
                        </button>
                    }
                </div>
            </div>
            <p class="mt-2 mb-0 card-text" style="white-space: pre-wrap; word-break: break-word;">@Html.DisplayFor(m => m.Content)</p>
             @if (Model.IsBlocked && User.IsInRole(AppRoles.Administrator))
            {
                <div class="mt-2 p-2 bg-danger-subtle border border-danger rounded small">
                    <i class="bi bi-slash-circle-fill text-danger me-1"></i>
                    This comment is currently <strong>BLOCKED</strong>.
                    <form asp-controller="Admin" asp-action="UnblockComment" method="post" class="d-inline ms-2">
                         @Html.AntiForgeryToken()
                        <input type="hidden" name="commentId" value="@Model.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-success py-0">Unblock</button>
                    </form>
                </div>
            }
            else if (Model.IsBlocked)  @* For non-admins, viewing a blocked comment in a context where it's shown (e.g., if logic changes) *@
            {
                 <div class="mt-2 p-2 bg-light border rounded small fst-italic text-muted">
                    <i class="bi bi-slash-circle me-1"></i>
                    Comment blocked by administrator.
                </div>
            }
        </div>

        @if (Model.CanEdit)
        {
            <div class="comment-edit-form mt-2" style="display: none;">
                <form asp-controller="Comments" asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Id" value="@Model.Id" />
                    <input type="hidden" name="ArticleId" value="@articleIdForView" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-1"></div>
                    <div class="mb-2">
                        <textarea name="Content" class="form-control form-control-sm" rows="3" required maxlength="1000">@Model.Content</textarea>
                        <span asp-validation-for="Content" class="text-danger small"></span>
                    </div>
                    <div>
                        <button type="submit" class="btn btn-sm btn-primary me-1"><i class="bi bi-check-lg me-1"></i>Save</button>
                        <button type="button" class="btn btn-sm btn-secondary cancel-edit-comment" data-comment-id="@Model.Id"><i class="bi bi-x-lg me-1"></i>Cancel</button>
                    </div>
                </form>
            </div>
        }
    </div>
</div>