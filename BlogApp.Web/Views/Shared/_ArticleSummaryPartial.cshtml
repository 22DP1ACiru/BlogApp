@model BlogApp.Web.Models.ArticleViewModel

@{
    var defaultProfilePic = "/images/default-profile.png";
    var authorProfilePic = string.IsNullOrEmpty(Model.AuthorProfilePictureUrl) ? defaultProfilePic : Model.AuthorProfilePictureUrl;
}

<div class="card mb-4 shadow-sm lift-on-hover">
    <div class="row g-0">
        <div class="col-md-4">
            <a asp-controller="Articles" asp-action="Details" asp-route-id="@Model.Id" class="d-block h-100">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" class="img-fluid rounded-start" alt="@Model.Title" style="height: 100%; width: 100%; object-fit: cover;">
                }
                else
                {
                    <div class="card-img-top-placeholder rounded-start">
                        <span><i class="bi bi-image fs-1"></i></span>
                    </div>
                }
            </a>
        </div>
        <div class="col-md-8">
            <div class="card-body d-flex flex-column h-100">
                <h5 class="card-title">
                    <a asp-controller="Articles" asp-action="Details" asp-route-id="@Model.Id">
                        @Html.DisplayFor(modelItem => Model.Title)
                    </a>
                </h5>
                <p class="card-text mb-2">
                    <small class="text-muted">
                        <img src="@authorProfilePic" alt="@Model.AuthorName" class="rounded-circle me-1 inline-profile-pic" />
                        By @Html.DisplayFor(modelItem => Model.AuthorName) on @Model.PublishedDate.ToString("MMM dd, yyyy")
                    </small>
                </p>
                <p class="card-text flex-grow-1 text-muted">
                    @* Ensure Raw is used if content might have HTML, otherwise DisplayFor is safer *@
                    @Html.Raw(Model.Content)
                </p>
                <div class="mt-auto text-end">
                    <a asp-controller="Articles" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-sm btn-primary">Read More <i class="bi bi-arrow-right-short"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .lift-on-hover {
        transition: transform .2s ease-out, box-shadow .2s ease-out;
    }
    .lift-on-hover:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>