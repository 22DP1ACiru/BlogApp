@model IEnumerable<BlogApp.Web.Models.ArticleViewModel>
@using BlogApp.Core.Constants

@{
    ViewData["Title"] = "Blog Articles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>@ViewData["Title"]</h1>
    @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole(AppRoles.Author) || User.IsInRole(AppRoles.Administrator)))
    {
        <a asp-action="Create" class="btn btn-success"><i class="bi bi-plus-circle-fill me-2"></i>Create New Article</a>
    }
</div>
<hr />

@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["StatusMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-journal-x display-1 text-muted"></i>
        <p class="lead mt-3">No articles have been published yet. Check back soon!</p>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm lift-on-hover">
                    <a asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none">
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" class="card-img-top" alt="@item.Title" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="card-img-top-placeholder">
                                <span><i class="bi bi-image fs-1"></i></span>
                            </div>
                        }
                    </a>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title">
                            <a asp-action="Details" asp-route-id="@item.Id">@Html.DisplayFor(modelItem => item.Title)</a>
                        </h5>
                        <p class="card-text mb-2">
                            <small class="text-muted">
                                @if (!string.IsNullOrEmpty(item.AuthorProfilePictureUrl))
                                {
                                    <img src="@item.AuthorProfilePictureUrl" alt="@item.AuthorName" class="rounded-circle me-1 inline-profile-pic" />
                                }
                                else
                                {
                                    <i class="bi bi-person-circle me-1 default-profile-pic-small"></i>
                                }
                                By @Html.DisplayFor(modelItem => item.AuthorName)
                                on @item.PublishedDate.ToString("MMM dd, yyyy")
                            </small>
                        </p>
                        <p class="card-text flex-grow-1 text-secondary">
                            @Html.Raw(item.Content) @* Assuming Content is a summary *@
                        </p>
                        <div class="mt-auto text-end">
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Read More <i class="bi bi-arrow-right-short"></i></a>
                        </div>
                    </div>
                    @if (User.Identity != null && User.Identity.IsAuthenticated && item.CanModify)
                    {
                        <div class="card-footer bg-transparent border-top-0 text-end pb-3">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary me-1"><i class="bi bi-pencil"></i> Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete</a>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
/* This can be moved to site.css if preferred */
.lift-on-hover {
    transition: transform .2s ease-out, box-shadow .2s ease-out;
}
.lift-on-hover:hover {
    transform: translateY(-5px);
    box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
}
</style>